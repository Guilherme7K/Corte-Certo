# Chave usada para assinar a sessão (gere uma com: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# Opcional em desenvolvimento (sem ela, usa SQLite local).
# Supabase: use a URL do pooler (Connect > Transaction pooler, porta 6543)
# postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres
DATABASE_URL=
